; Angular 20's deprecated packages (@angular/platform-browser-dynamic, @angular/animations)
; stopped advancing past 20.0.x/20.1.x while core/compiler moved to 20.3.x. The example's
; NgModule bootstrap still uses platform-browser-dynamic, so strict peer resolution fails.
; This is an Angular toolchain quirk unrelated to the background-geolocation plugin.
legacy-peer-deps=true
